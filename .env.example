# Feature flag: mantener en false hasta completar migracion, secretos y NubeSDK.
TIENDANUBE_ENABLED=false
TIENDANUBE_ENV=production

# Identidad publica/configuracion. Reemplazar todos los placeholders.
TIENDANUBE_APP_ID=38321
TIENDANUBE_API_VERSION=2025-03
# Dejar vacio durante el primer OAuth. Configurar luego el user_id devuelto.
TIENDANUBE_STORE_ID=
TIENDANUBE_USER_AGENT=replace_with_app_name_and_contact
TIENDANUBE_STOREFRONT_URL=https://replace-with-storefront.example/
TIENDANUBE_ALLOWED_SETUP_ORIGINS=https://replace-with-landing.example
TIENDANUBE_ALLOWED_STOREFRONT_ORIGINS=https://replace-with-storefront.example
TIENDANUBE_OAUTH_REDIRECT_URL=https://setupoficina.com.ar/api/tiendanube/oauth/callback
TIENDANUBE_EXPECTED_STORE_DOMAINS=replace_with_expected_store_domains
TIENDANUBE_API_TIMEOUT_MS=5000
TIENDANUBE_API_MAX_RETRIES=2

# Variable de build del script NubeSDK. Vacia usa produccion; para demo se
# configura temporalmente con un Preview aprobado de setupoficina-landing.pages.dev.
SETUPOFICINA_BACKEND_URL=

# Secretos: usar Cloudflare Pages Secrets; nunca versionar valores reales.
# TIENDANUBE_ACCESS_TOKEN es solo un fallback temporal para Preview/desarrollo;
# produccion carga exclusivamente el token cifrado guardado en D1 por OAuth.
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_CLIENT_SECRET=replace_with_pages_secret
TIENDANUBE_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_pages_secret
